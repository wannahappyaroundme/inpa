# === 인파 백엔드 환경변수 (.env로 복사해서 사용) ===
# 시크릿 — 운영은 반드시 교체
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*

# DB (운영 PostgreSQL 예시 = Neon — 로컬은 SQLite 자동 사용)
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/inpa?sslmode=require

# 인증 토큰 TTL
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TIMEOUT=3600
# 내부 시연 계정. 운영 값은 배포 환경에만 입력하고, 비밀번호 값은 저장소에 두지 않는다.
SHOWCASE_ACCOUNT_EMAIL=
SHOWCASE_ACCOUNT_PASSWORD=

# 이메일 발송 (로컬=콘솔 출력 / 운영=Resend SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@inpa.local
# 운영 예시:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxx
# EMAIL_USE_SSL=True

# 프론트엔드 (이메일 링크 생성용)
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Claude API (Phase 1.1 — 증권 OCR 파싱·담보 정규화)
# 비어 있으면 OCR 업로드가 503(OCR_UNAVAILABLE) 반환 — 키 주입 시 활성화. 하드코딩 금지.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_PARSE=
CLAUDE_MODEL_BULK=

# 비공개 추출 비교 평가 전용. 운영 대체 공급자나 자동 재시도 경로가 아니다.
# requirements-eval.txt를 따로 설치한 접근 통제 staging shell에서만 설정한다.
OPENAI_EVAL_API_KEY=
OPENAI_EVAL_MODEL=

# 보험증권 검토형 가져오기. 운영 검증·승인 전에는 False 유지.
INSURANCE_REVIEW_GATE_ENABLED=False
# 스냅샷 없는 과거 공유 링크를 잠시 열어야 할 때만 True로 설정.
LEGACY_SHARE_FALLBACK_ENABLED=False
# 보장 기준선 판정. 운영은 설계사가 직접 확인해 저장한 기준만 판정하므로 그때만 True로 설정.
HEATMAP_GRADING_ENABLED=False
# 20명×3건 합성 staging 부하 자료 생성·정리 전용. 평소와 운영은 False 유지.
INSURANCE_LOAD_TEST_ENABLED=False
INSURANCE_SOURCE_RETENTION_HOURS=24
INSURANCE_IMPORT_PER_OWNER_LIMIT=2
INSURANCE_IMPORT_GLOBAL_LIMIT=4
INSURANCE_MAX_PAGES=300
INSURANCE_MAX_EXTRACTED_CHARS=500000
INSURANCE_MAX_CANDIDATES=2000
INSURANCE_MAX_QUEUED_PER_OWNER=10
# 로컬 eager 실행에는 불필요. 운영 web/worker는 같은 private Key Value URL 사용.
REDIS_URL=redis://localhost:6379/0

# 비공개 보험 원본 저장소. staging은 운영과 다른 버킷·접근 키를 사용한다.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

# 상담 녹음. 전용 비공개 버킷과 별도 키를 쓰고, R2 lifecycle은 31일 이상으로 설정한다.
# 코드와 운영 설정을 모두 연 뒤에도 파일럿 허용 계정만 녹음할 수 있다.
CONSULTATION_RECORDING_ENABLED=False
CONSULTATION_AI_SUMMARY_ENABLED=False
CONSULTATION_SHOWCASE_PILOT_ENABLED=False
CONSULTATION_AI_COMPARISON_ENABLED=False
CONSULTATION_RETENTION_HOURS=720
CONSULTATION_COMPARISON_MAX_BYTES=26214400
CONSULTATION_COMPARISON_MAX_DURATION_SECONDS=300
CONSULTATION_COMPARISON_REQUEST_DEADLINE_SECONDS=110
CONSULTATION_COMPARISON_CONNECT_TIMEOUT_SECONDS=2
CONSULTATION_COMPARISON_TRANSCRIPTION_READ_TIMEOUT_SECONDS=35
CONSULTATION_COMPARISON_SUMMARY_READ_TIMEOUT_SECONDS=25
CONSULTATION_COMPARISON_WRITE_TIMEOUT_SECONDS=5
CONSULTATION_COMPARISON_POOL_TIMEOUT_SECONDS=1
CONSULTATION_STORAGE_BUCKET=
CONSULTATION_STORAGE_ENDPOINT=
CONSULTATION_STORAGE_REGION=auto
CONSULTATION_STORAGE_ACCESS_KEY_ID=
CONSULTATION_STORAGE_SECRET_ACCESS_KEY=
CONSULTATION_UPLOAD_RATE=30/hour
CONSULTATION_PLAY_RATE=120/hour
CONSULTATION_SUMMARY_RATE=30/hour
CONSULTATION_CALLBACK_RATE=120/hour
CONSULTATION_COMPARISON_RATE=10/hour
CONSULTATION_STT_PROVIDER=clova
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET_KEY=
CONSULTATION_SUMMARY_MODEL=
CONSULTATION_SUMMARY_PROVIDER=anthropic
CONSULTATION_AI_REQUEST_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
# 화자 구분 전용 모델. 비우면 비교용 OPENAI_TRANSCRIPTION_MODEL을 사용한다.
OPENAI_CONSULTATION_TRANSCRIPTION_MODEL=
OPENAI_COMPARISON_MODEL=
# 비우면 OPENAI_COMPARISON_MODEL을 사용한다. 실제 모델 ID는 Render에만 입력한다.
OPENAI_CONSULTATION_SUMMARY_MODEL=
OPENAI_USD_KRW_RATE=1400
OPENAI_TRANSCRIPTION_USD_PER_MINUTE=0.006
# 0이면 실제 응답 모델 이름에 맞는 보수적 내장 단가를 사용한다.
OPENAI_CONSULTATION_INPUT_USD_PER_MTOK=0
OPENAI_CONSULTATION_OUTPUT_USD_PER_MTOK=0
ANTHROPIC_COMPARISON_MODEL=
CONSULTATION_SUMMARY_PROMPT_VERSION=v1-2026-07-22
CONSULTATION_SUMMARY_ACTIVE_LIMIT=1
CONSULTATION_SUMMARY_LEASE_SECONDS=300
CONSULTATION_SUMMARY_POLL_SECONDS=15
CONSULTATION_CALLBACK_TTL_SECONDS=7200
BACKEND_BASE_URL=http://localhost:8000

# 카드 등록형 쿠폰·정기결제. 외부 심사와 샌드박스 검증 전에는 모두 False로 둔다.
BILLING_CARD_REGISTRATION_ENABLED=False
BILLING_RECURRING_CHARGE_ENABLED=False
BILLING_WEBHOOK_RECONCILIATION_ENABLED=False
KICC_MALL_ID=
KICC_CLIENT_SECRET=
KICC_API_BASE_URL=https://testpgapi.easypay.co.kr
PAYMENT_TOKEN_ENCRYPTION_KEY=
PAYMENT_TOKEN_KEY_VERSION=v1
BILLING_NOTICE_DEVICE_HMAC_KEY=
FREE_TRIAL_PHONE_VERIFICATION_ENABLED=False
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
# 무작위 32-byte 이상 비밀값. 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_IDENTITY_HMAC_KEY=
PHONE_IDENTITY_HMAC_KEY_VERSION=v1

# 구글 연동 (소셜 로그인 + 캘린더) — 전부 비어 있으면 기능 숨김(무해).
# 로그인은 CLIENT_ID만, 캘린더는 SECRET+REDIRECT_URI까지 필요. CLIENT_SECRET은 ★시크릿(Render 전용).
GOOGLE_OAUTH_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 캘린더 콜백(구글 콘솔 redirect URI와 정확히 일치, 끝 슬래시 포함):
# 예) https://<render-be>/api/v1/auth/google/calendar/callback/
GOOGLE_OAUTH_REDIRECT_URI=
